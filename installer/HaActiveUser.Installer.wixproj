<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>HAActiveUser</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE61</SuppressIces>
    <!-- Both applications are single-file publishes, so no harvesting is required. -->
    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\src\HaActiveUser.Agent\bin\Release\net8.0-windows\win-x64\publish\</AgentPublishDir>
    <SessionAgentPublishDir Condition="'$(SessionAgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\src\HaActiveUser.SessionAgent\bin\Release\net8.0-windows\win-x64\publish\</SessionAgentPublishDir>
    <DefineConstants>AgentPublishDir=$(AgentPublishDir);SessionAgentPublishDir=$(SessionAgentPublishDir);ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="VerifyAgentPublished" BeforeTargets="Build">
    <Error
      Condition="!Exists('$(AgentPublishDir)HaActiveUser.Agent.exe')"
      Text="Publish the agent first: pwsh ./build/publish-agent.ps1 (expected $(AgentPublishDir)HaActiveUser.Agent.exe)" />
    <Error
      Condition="!Exists('$(SessionAgentPublishDir)HaActiveUser.SessionAgent.exe')"
      Text="Publish the session agent first: pwsh ./build/publish-agent.ps1 (expected $(SessionAgentPublishDir)HaActiveUser.SessionAgent.exe)" />
  </Target>

</Project>
